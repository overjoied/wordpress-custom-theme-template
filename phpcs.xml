<?xml version="1.0"?>
<ruleset name="Custom Theme">
	<description>WordPress Coding Standards for this theme.</description>

	<file>.</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Generated by build-block-manifest; regenerated/overwritten on every build. -->
	<exclude-pattern>*/src/blocks/blocks-manifest.php</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<!--
			Excluded: this sniff enters an infinite fixer loop on files mixing
			inline HTML with PHP short-close tags (?>), a known PHPCS limitation,
			not a real code issue. See phpcbf's "possible conflict" output on
			Generic.WhiteSpace.ScopeIndent for the affected token each time.
		-->
		<exclude name="Generic.WhiteSpace.ScopeIndent"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="custom-theme"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.7"/>
</ruleset>
