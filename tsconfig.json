{
    "compilerOptions": {
      "target": "es6",
      "module": "esnext",
      "outDir": "build",
      "rootDir": "src",
      "moduleResolution": "bundler",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "allowJs": false, 
      "resolveJsonModule": true
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "node_modules"
    ]
}
  